{
  "name": "video-essay-studio",
  "private": true,
  "version": "0.1.0",
  "description": "A desktop studio for creating narrated vertical video essays.",
  "author": "Video Essay Studio",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k -s first \"vite --host 127.0.0.1 --port 5178 --strictPort\" \"vite build --watch --config vite.electron.config.ts\" \"wait-on http://127.0.0.1:5178 file:dist-electron/main.cjs && VITE_DEV_SERVER_URL=http://127.0.0.1:5178 electron .\"",
    "desktop:compile": "tsc -p tsconfig.electron.json && vite build --config vite.electron.config.ts",
    "desktop:build": "npm run build && npm run desktop:compile && electron-builder --mac --arm64"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "motion": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "^10.0.5",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0",
    "wait-on": "^9.1.0",
    "typescript": "latest"
  },
  "build": {
    "appId": "com.videoessaystudio.app",
    "productName": "Video Essay Studio",
    "afterPack": "electron/afterPack.cjs",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg",
        "to": "ffmpeg/ffmpeg"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "identity": null,
      "target": [
        {
          "target": "dir",
          "arch": ["arm64"]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Video Essay Studio uses the microphone to record narration for your video essays."
      }
    }
  }
}
